# ==========================================
# DASTAVEZ MITRA - Environment Configuration Example
# Configure these variables in Vercel Project Settings > Environment Variables
# ==========================================

# Admin Dashboard Password (Default for local development if unset: dastavez@admin2026)
ADMIN_PASSWORD=your_secure_admin_password_here

# Secret key used for signing session authentication tokens
JWT_SECRET=your_random_64_character_hex_secret_here

# Optional: Cloud Database Connection String (PostgreSQL / Supabase / Neon)
# If provided, leads will be automatically synchronized with your cloud database.
# If not provided, leads are securely stored in resilient serverless file/cache storage.
DATABASE_URL=postgresql://user:password@host:5432/dastavezmitra?sslmode=require

# Optional: Supabase Connection (alternative to DATABASE_URL)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
